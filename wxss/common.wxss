/* WeChat style:v2 gives normal buttons a fixed 184px width.
 * Every custom button declares size=default; reset its platform geometry,
 * then let the explicit button[size=default].<component> selectors win. */
button[size="default"]{width:auto;min-width:0;margin-left:0;margin-right:0;padding:0;font-weight:400}
page{background:#F9F8F5;color:#101A1C;font-family:-apple-system,BlinkMacSystemFont,"Segoe UI","Microsoft YaHei",sans-serif;font-size:16px;line-height:1.5}
view,button,button[size="default"],input,scroll-view{box-sizing:border-box}button,button[size="default"]{font:inherit;background:transparent;color:inherit;margin:0;padding:0;border-radius:0;line-height:inherit}button::after,button[size="default"]::after{border:0}button[disabled],button[size="default"][disabled]{opacity:.45}button[disabled].primary,button[size="default"][disabled].primary{background:#244F3E;color:#fff}
.page{padding:20px 20px calc(24px + env(safe-area-inset-bottom))}.row,.between{display:flex;align-items:center;gap:12px}.between{justify-content:space-between}.grow{flex:1;min-width:0}
.serif,.title,.section-title,.chapter-title{font-family:"Times New Roman","Songti SC",SimSun,serif}.title{font-size:46px;line-height:1.1;letter-spacing:-1px;margin:20px 0 18px;overflow-wrap:break-word}.muted{color:#687078}.small,button[size="default"].small{font-size:13px}.quiet,button[size="default"].quiet{font-size:14px;color:#426257;text-align:left}.section-title{font-size:22px}.action,button[size="default"].action{padding:11px 18px;border-radius:12px;text-align:center;font-size:16px;line-height:24px;margin-top:16px}.primary,button[size="default"].primary{background:#244F3E;color:#fff}.outline,button[size="default"].outline{border:1px solid #80948D}.card{padding:16px;background:#E8EEE7;border-radius:12px;margin:24px 0}.rule{border-bottom:1px solid #DCDDD8}.list-header{margin:22px 0 0;padding:20px 0 16px;border-top:1px solid #DCDDD8;border-bottom:1px solid #DCDDD8}.empty{padding:48px 0;text-align:center;color:#687078}.notice,button[size="default"].notice{display:flex;align-items:center;gap:12px;padding:12px 14px;border-radius:7px;background:#F7EFDD;color:#946924;font-size:13px;margin:12px 0}.error{color:#A84E37}.status{color:#687078;font-size:12px;margin-top:24px}.chapter-row,button[size="default"].chapter-row{display:flex;align-items:center;gap:24px;padding:20px 0;border-bottom:1px solid #DCDDD8;width:100%;text-align:left}.chapter-no{color:#101A1C;font-family:"Times New Roman",serif;font-size:20px}.chapter-title{font-size:24px;line-height:1.25;margin-bottom:4px}.badge{display:inline-block;padding:4px 12px;background:#E8EEE7;color:#244F3E;font-size:12px;border-radius:20px;white-space:nowrap}.setting{padding:20px 0;border-bottom:1px solid #DCDDD8}.choice,button[size="default"].choice{flex:1;text-align:center;padding:10px 6px;border:1px solid #C9CECA;border-radius:12px;font-family:"Times New Roman",serif;font-size:18px}.choice.active,button[size="default"].choice.active{background:#244F3E;color:#fff;border-color:#244F3E}.choices{display:flex;gap:10px;margin-top:10px}navigator{color:#426257}.footer{margin-top:32px;font-size:12px;color:#687078}.label{font-size:14px;color:#426257}.pressed{opacity:.65}.row-pressed{background:#E8EEE766}button,button[size="default"],navigator{transition:background-color 160ms ease,opacity 160ms ease}@media(prefers-reduced-motion:reduce){button,button[size="default"],navigator{transition:none}}

.action,button[size="default"].action{display:block;width:100%}
