page {
  background:#F7F6F2;
  color:#202C28;
  font-family:-apple-system,BlinkMacSystemFont,"Segoe UI",sans-serif;
  font-size:16px;
  line-height:1.6
}
view,button,input,scroll-view {
  box-sizing:border-box
}
button {
  font:inherit;
  background:transparent;
  color:inherit;
  margin:0;
  padding:0;
  border-radius:0;
  line-height:inherit
}
button::after {
  border:0
}
button[disabled] {
  opacity:.45;
  color:inherit;
  background:transparent
}
.page {
  padding:24px 24px calc(32px + env(safe-area-inset-bottom))
}
.row,.between {
  display:flex;
  align-items:center;
  gap:12px
}
.between {
  justify-content:space-between
}
.grow {
  flex:1;
  min-width:0
}
.serif,.title {
  font-family:Georgia,"Times New Roman",serif
}
.title {
  font-size:42px;
  line-height:1.12;
  letter-spacing:-1.5px;
  margin:26px 0 18px;
  overflow-wrap:break-word
}
.muted {
  color:#788079
}
.small {
  font-size:12px
}
.quiet {
  font-size:14px;
  color:#4D6659;
  text-align:left
}
.eyebrow {
  font-size:11px;
  letter-spacing:3px;
  color:#66786B
}
.section-title {
  font-size:22px;
  font-family:Georgia,serif
}
.action {
  padding:12px 18px;
  border-radius:7px;
  text-align:center;
  font-size:14px;
  line-height:24px;
  margin-top:18px
}
.primary {
  background:#244C3C;
  color:#fff
}
.outline {
  border:1px solid #C8CEC5
}
.card {
  padding:22px;
  background:#E7EEE6;
  border-radius:10px;
  margin:28px 0
}
.rule {
  border-bottom:1px solid #DEDFD7
}
.list-header {
  margin:30px 0 8px
}
.empty {
  padding:50px 0;
  text-align:center;
  color:#788079
}
.notice {
  padding:12px 14px;
  border-radius:6px;
  background:#ECECE3;
  color:#635D44;
  font-size:13px;
  margin:14px 0
}
.error {
  color:#944E3B
}
.status {
  color:#788079;
  font-size:12px;
  margin-top:24px
}
.chapter-row {
  display:flex;
  align-items:center;
  gap:18px;
  padding:21px 0;
  border-bottom:1px solid #DEDFD7;
  width:100%;
  text-align:left
}
.chapter-no {
  color:#839080;
  font-family:Georgia,serif;
  font-size:18px
}
.chapter-title {
  font-size:20px;
  font-family:Georgia,serif;
  line-height:1.4
}
.badge {
  display:inline-block;
  padding:3px 8px;
  background:#E7EEE6;
  color:#46614E;
  font-size:11px;
  border-radius:3px
}
.setting {
  padding:23px 0;
  border-bottom:1px solid #DEDFD7
}
.choice {
  padding:8px 12px;
  border:1px solid #D9DED5;
  border-radius:5px;
  font-size:13px
}
.choice.active {
  background:#244C3C;
  color:white;
  border-color:#244C3C
}
.choices {
  display:flex;
  flex-wrap:wrap;
  gap:10px;
  margin-top:16px
}
navigator {
  color:#4D6659
}
.footer {
  margin-top:42px;
  font-size:12px;
  color:#899187
}
.label {
  font-size:13px;
  color:#65756B
}

