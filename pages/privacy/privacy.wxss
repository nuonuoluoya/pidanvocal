.privacy-page{padding-top:14px;min-height:calc(100vh - 88px);display:flex;flex-direction:column}.privacy-page .title{font-size:46px;line-height:1.17;font-weight:600;margin:12px 0 20px}.privacy-item{display:flex;align-items:flex-start;gap:24px;padding:24px 0;border-bottom:1px solid #DCDDD8}.privacy-number{font-family:"Times New Roman",serif;font-size:22px;line-height:1.5}.body-text{font-size:15px;color:#687078;margin-top:6px;line-height:1.7}.privacy-storage{padding:20px 0 32px}.contact-button,button[size="default"].contact-button{width:100%;margin-top:auto;flex-shrink:0}
