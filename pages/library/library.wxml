<view class="library-page">
  <q-nav title="Pidan Vocal"/>
  <view class="library-content">
    <view class="library-heading">
      <text class="library-title">书架</text>
      <navigator url="/pages/settings/settings" class="library-settings" hover-class="library-pressed">
        <text>我的与设置</text><q-icon name="arrow-right" color="muted" size="17"/>
      </navigator>
    </view>
    <view class="library-tabs" role="tablist">
      <button size="default" class="library-tab {{audience==='member'?'is-selected':''}}" role="tab" aria-selected="{{audience==='member'}}" data-value="member" bindtap="changeAudience" hover-class="library-pressed">我的书籍</button>
      <button size="default" class="library-tab {{audience==='sample'?'is-selected':''}}" role="tab" aria-selected="{{audience==='sample'}}" data-value="sample" bindtap="changeAudience" hover-class="library-pressed">体验样本</button>
    </view>
    <view wx:if="{{recent}}" class="library-recent">
      <text class="library-recent-label">最近阅读</text>
      <view class="library-recent-title">{{recent.title}}</view>
      <view class="library-position">{{recent.position}}</view>
      <button size="default" class="library-continue" bindtap="continueReading" hover-class="library-primary-pressed">
        <text>继续学习</text><q-icon name="arrow-right" color="white" size="22"/>
      </button>
    </view>
    <view class="library-list-heading">
      <text class="library-section-title">{{audience==='member'?'我的书籍':'体验样本'}}</text>
      <button size="default" class="library-refresh" bindtap="retry" disabled="{{busy}}" hover-class="library-pressed" aria-label="刷新书架">
        <q-icon name="refresh" color="muted" size="19"/><text>刷新</text>
      </button>
    </view>
    <view wx:if="{{error}}" class="notice error" role="alert">
      {{error}}
      <button size="default" class="action outline" bindtap="retry" disabled="{{busy}}">重新加载</button>
    </view>
    <button size="default" wx:for="{{books}}" wx:key="bookId" class="library-book" data-id="{{item.bookId}}" bindtap="openBook" hover-class="library-row-pressed" aria-label="{{item.title}}，进入章节目录">
      <view class="library-cover cover-{{item.coverTone}}" aria-hidden="true">
        <text class="library-cover-initials">{{item.coverInitials}}</text><view class="library-cover-rule"/>
      </view>
      <view class="library-book-copy">
        <view class="library-book-title">{{item.title}}</view>
        <view class="library-book-meta">{{item.metadata}}</view>
        <view class="library-book-scope">{{item.contentScope==='sample'?'样本内容':'完整内容'}}</view>
        <view class="library-audio {{item.audioComplete?'is-available':'is-partial'}}">全文：{{item.audioLabel}}</view>
      </view>
      <q-icon name="arrow-right" size="18" color="muted"/>
    </button>
    <view wx:if="{{busy}}" class="library-empty" role="status">正在加载书籍…</view>
    <view wx:elif="{{!books.length && !error}}" class="library-empty">{{audience==='member'?'暂时没有可阅读的内容':'样本正在准备中'}}</view>
    <button size="default" wx:if="{{nextCursor}}" class="library-more" disabled="{{busy}}" bindtap="loadMore" hover-class="library-pressed">
      <text>加载更多</text><q-icon name="chevron-down" color="muted" size="19"/>
    </button>
  </view>
</view>
