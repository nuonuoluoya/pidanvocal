<view class="page">
  <view class="between">
    <view class="row">
      <q-icon name="book" color="green"/>
      <text class="brand serif">
        Quill
      </text>
    </view>
    <navigator url="/pages/settings/settings" class="quiet">
      我的与设置
    </navigator>
  </view>
  <view class="eyebrow intro">
    A LITTLE, EVERY DAY
  </view>
  <view class="title">
    让英文阅读，
    <view>
      成为日常。
    </view>
  </view>
  <text class="muted">
    从一本书、一句话开始，读懂，也听懂。
  </text>
  <view wx:if="{{recent}}" class="card">
    <text class="label">
      继续上次的阅读
    </text>
    <view class="recent-title serif">
      {{recent.title}}
    </view>
    <view class="muted small">
      {{recent.position}}
    </view>
    <button class="action primary" bindtap="continueReading">
      继续学习 →
    </button>
  </view>
  <view class="between list-header">
    <text class="section-title">
      我的书架
    </text>
    <text class="muted small">
      一步一步，慢慢读
    </text>
  </view>
  <view class="tabs">
    <button class="tab {{audience==='sample'?'selected':''}}" data-value="sample" bindtap="changeAudience">
      体验样本
    </button>
    <button class="tab {{audience==='member'?'selected':''}}" data-value="member" bindtap="changeAudience">
      我的内容
    </button>
  </view>
  <view wx:if="{{error}}" class="notice error">
    {{error}}
    <button class="action outline" bindtap="retry">
      重新加载
    </button>
  </view>
  <button wx:for="{{books}}" wx:key="bookId" class="book-row" data-id="{{item.bookId}}" bindtap="openBook">
    <view class="book-cover">
      <q-icon name="book" color="green" size="30"/>
      <text class="cover-label">
        QUILL
        <view>
          READERS
        </view>
      </text>
    </view>
    <view class="grow">
      <view class="book-title serif">
        {{item.title}}
      </view>
      <view class="muted small">
        {{item.chapterCount}} 章 · {{item.sentenceCount}} 句
      </view>
      <view class="book-meta">
        <text class="badge">
          {{item.contentScope==='sample'?'样本':'完整内容'}}
        </text>
        <text class="muted small">
          整章音频 · {{item.audioLabel}}
        </text>
      </view>
    </view>
    <q-icon name="arrow-right" size="18" color="muted"/>
  </button>
  <view wx:if="{{busy}}" class="empty">
    正在整理书架…
  </view>
  <view wx:elif="{{!books.length && !error}}" class="empty">
    {{audience==='member'?'暂时没有可阅读的内容':'样本正在准备中'}}
  </view>
  <view wx:elif="{{books.length && !nextCursor}}" class="footer">
    每读一句，都离故事更近一点。
  </view>
</view>
