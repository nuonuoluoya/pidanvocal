<q-sheet open="{{open}}" title="选择要保留的进度" bindclose="later">
  <text class="muted small">
    云端与本机的阅读位置需要确认。
  </text>
  <view class="card">
    本机
    <view class="serif">
      {{local}}
    </view>
  </view>
  <view class="card">
    云端
    <view class="serif">
      {{cloud}}
    </view>
  </view>
  <button class="action outline" disabled="{{busy}}" data-choice="cloud" bindtap="choose">
    使用云端
  </button>
  <button class="action primary" disabled="{{busy}}" data-choice="local" bindtap="choose">
    {{resetting?'清除云端当前版本进度':'保留本机并同步'}}
  </button>
  <button class="action quiet" disabled="{{busy}}" bindtap="later">
    稍后处理
  </button>
  <view class="status">
    选择后不会自动播放
  </view>
</q-sheet>
