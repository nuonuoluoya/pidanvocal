<view wx:if="{{open}}" class="overlay" catchtouchmove="noop">
  <view class="backdrop" bindtap="close"/>
  <view class="sheet">
    <view class="heading">
      <text>
        {{title}}
      </text>
      <button bindtap="close" aria-label="关闭">
        ×
      </button>
    </view>
    <scroll-view scroll-y class="body">
      <slot/>
    </scroll-view>
  </view>
</view>
